      "tipo": "formula",
      "latex": "A = \\begin{pmatrix} 0 & 3 & 1 & 2 \\\\ 5 & 0 & 3 & 6 \\\\ 2 & 1 & 0 & 4 \\\\ 6 & 0 & 6 & 0 \\end{pmatrix}"
