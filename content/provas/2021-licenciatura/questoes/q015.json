  "enunciado": [
    {
      "tipo": "paragrafo",
      "texto": "Considerando que, dados os inteiros $m$ e $n$, o $\\operatorname{mdc}(m, n)$ é o maior divisor comum, e o $\\operatorname{mmc}(m, n)$ é o menor múltiplo comum de $m$ e $n$, avalie as afirmações a seguir."
    },
    {
      "tipo": "afirmativas",
      "itens": [
        {
          "rotulo": "I",
          "texto": "O resto da divisão de $7 \\times 18 - 2$ por 7 é 5."
        },
        {
          "rotulo": "II",
          "texto": "Se $m = 7 \\times 22 + 5$ e $n = 7 \\times 38 + 6$, o resto da divisão de $m + n$ por 7 é 3."
        },
        {
          "rotulo": "III",
          "texto": "O $\\operatorname{mmc}(m, n)$ é um divisor do $\\operatorname{mdc}(m, n)$."
        },
        {
          "rotulo": "IV",
          "texto": "$\\operatorname{mdc}(m, n) \\times \\operatorname{mmc}(m, n) = m \\times n$."
        }
      ]
    },
    {
      "tipo": "paragrafo",
      "texto": "É correto apenas o que se afirma em"
    }
  ],
