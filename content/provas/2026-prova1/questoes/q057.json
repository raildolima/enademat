  "enunciado": [
    {
      "tipo": "paragrafo",
      "texto": "Como o ponto $P$ deve ser determinado a partir dos pontos $A$ e $D$ para que o carro representado pelo ponto $P$ permaneça centralizado na rua?"
    }
  ],
  "alternativas": [
    {
      "letra": "A",
      "blocos": [{ "tipo": "paragrafo", "texto": "$\\overrightarrow{AP} = -\\overrightarrow{DP}$." }]
    },
    {
      "letra": "B",
      "blocos": [{ "tipo": "paragrafo", "texto": "$\\overrightarrow{AP} = \\overrightarrow{DP}$." }]
    },
    {
      "letra": "C",
      "blocos": [{ "tipo": "paragrafo", "texto": "$\\overrightarrow{AP} = \\frac{1}{2}\\overrightarrow{DP}$." }]
    },
